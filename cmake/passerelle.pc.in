#
# cmake/passerelle.pc.in - pkg-config description of the installed stack.
#
# Generated by CMake (see cmake/passerelle-install.cmake): the version comes
# from the VERSION file, the library list from the libraries that were really
# built. Do not edit the generated passerelle.pc: edit this template.
#
# The prefix is derived from the location of this file (${pcfiledir}), so the
# installed tree stays relocatable: `make install DESTDIR=...` or a moved
# prefix need no edit here.

prefix=${pcfiledir}/..
exec_prefix=${prefix}
libdir=${prefix}
includedir=${prefix}/@PGW_PC_INCLUDEDIR@

Name: @PGW_PKG_NAME@
Description: @PGW_PKG_DESCRIPTION@
URL: https://github.com/BaptisteFaisy/passerelle
Version: @PGW_VERSION@
Libs: -L${libdir} @PGW_PC_LIBS@
Cflags: -I${includedir}
