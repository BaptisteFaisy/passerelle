+# --- virtio PCI capability decoder: portable, host-testable -----------------
+# It takes a config-space read callback instead of touching a bus, so the
+# decoding arithmetic is unit-tested on the host exactly like lib9p, and the
+# QNX-only transport is left with the parts that need the hardware.
+add_library(virtio_pci_caps STATIC src/virtio_pci_caps.c)
+set_target_properties(virtio_pci_caps PROPERTIES
+    C_STANDARD 11
+    C_STANDARD_REQUIRED ON
+    C_EXTENSIONS OFF
+)
