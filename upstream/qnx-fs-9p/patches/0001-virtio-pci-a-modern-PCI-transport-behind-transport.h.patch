diff --git a/tests/unit/test_virtio_pci_caps.c b/tests/unit/test_virtio_pci_caps.c
new file mode 100644
index 0000000..e40e703
--- /dev/null
+++ b/tests/unit/test_virtio_pci_caps.c
@@ -0,0 +1,174 @@
+/*
+ * Host unit tests for the virtio PCI capability decoder.
+ *
+ * The decoder takes a config-space read callback, so a synthetic 256-byte
+ * config space is enough to test it without a device, a bus or QNX: this is
+ * the part of the PCI transport that can be proven on a PC.
+ */
+#include "test.h"
+
+#include "virtio_pci_caps.h"
+
+#include <stdbool.h>
+
+/* A 256-byte config space, optionally refusing reads below 0x40 the way
+ * QNX's pci_device_cfg_rd*() does. */
+typedef struct {
+    uint8_t bytes[256];
+    bool deny_below_0x40;
+    unsigned reads;
+} fake_cfg_t;
+
+static int fake_read(void *ctx, uint32_t off, void *dst, size_t len)
+{
+    fake_cfg_t *c = ctx;
+
+    if (c->deny_below_0x40 && off < 0x40u)
+        return -1;
+    if ((size_t)off + len > sizeof c->bytes)
+        return -1;
+    memcpy(dst, c->bytes + off, len);
+    c->reads++;
+    return 0;
+}
+
+static void put_u32(fake_cfg_t *c, uint32_t off, uint32_t v)
+{
+    for (unsigned i = 0; i < 4u; i++)
+        c->bytes[off + i] = (uint8_t)(v >> (8u * i));
+}
+
+/* One vendor-specific capability: the 4-byte PCI header, the BAR byte, three
+ * padding bytes, then offset and length (and the notify multiplier). */
+static void put_virtio_cap(fake_cfg_t *c, uint32_t off, uint8_t next, uint8_t type, uint8_t bar,
+                           uint32_t cap_off, uint32_t len, uint32_t multiplier)
+{
+    const uint8_t cap_len = type == VPCI_CFG_NOTIFY ? 20u : 16u;
+
+    c->bytes[off + 0u] = VPCI_CAP_ID_VENDOR;
+    c->bytes[off + 1u] = next;
+    c->bytes[off + 2u] = cap_len;
+    c->bytes[off + 3u] = type;
+    put_u32(c, off + 4u, bar);
+    put_u32(c, off + 8u, cap_off);
+    put_u32(c, off + 12u, len);
+    if (cap_len == 20u)
+        put_u32(c, off + 16u, multiplier);
+}
+
+/* A device with the four usual capabilities, linked from 0x40. */
+static void build_device(fake_cfg_t *c)
+{
+    memset(c, 0, sizeof *c);
+    c->bytes[0x06] = 0x10u; /* status: capability list present */
+    c->bytes[0x34] = 0x40u; /* first capability */
+    put_virtio_cap(c, 0x40u, 0x50u, VPCI_CFG_COMMON, 4u, 0x1000u, 0x1000u, 0u);
+    put_virtio_cap(c, 0x50u, 0x64u, VPCI_CFG_NOTIFY, 4u, 0x2000u, 0x1000u, 4u);
+    put_virtio_cap(c, 0x64u, 0x74u, VPCI_CFG_ISR, 4u, 0x3000u, 0x1000u, 0u);
+    put_virtio_cap(c, 0x74u, 0x00u, VPCI_CFG_DEVICE, 4u, 0x4000u, 0x1000u, 0u);
+}
+
+static void test_chain_finds_every_capability(void)
+{
+    fake_cfg_t cfg;
+    vpci_caps_t caps;
+
+    build_device(&cfg);
+    CHECK_EQ(vpci_caps_scan_chain(fake_read, &cfg, &caps), 0);
+    CHECK(vpci_caps_usable(&caps));
+    CHECK(caps.have_common);
+    CHECK(caps.have_notify);
+    CHECK(caps.have_isr);
+    CHECK(caps.have_device);
+    CHECK_EQ(caps.common.bar, 4);
+    CHECK_EQ(caps.common.offset, 0x1000);
+    CHECK_EQ(caps.device.offset, 0x4000);
+    CHECK_EQ(caps.notify.notify_off_multiplier, 4);
+}
+
+static void test_chain_rejects_a_cycle(void)
+{
+    fake_cfg_t cfg;
+    vpci_caps_t caps;
+
+    build_device(&cfg);
+    cfg.bytes[0x75] = 0x40u; /* DEVICE points back at COMMON */
+    CHECK_EQ(vpci_caps_scan_chain(fake_read, &cfg, &caps), 0);
+    CHECK(vpci_caps_usable(&caps));
+}
+
+static void test_missing_notify_is_not_usable(void)
+{
+    fake_cfg_t cfg;
+    vpci_caps_t caps;
+
+    build_device(&cfg);
+    cfg.bytes[0x40 + 3u] = VPCI_CFG_DEVICE; /* no COMMON either */
+    cfg.bytes[0x50 + 3u] = VPCI_CFG_ISR;    /* and no NOTIFY */
+    CHECK_EQ(vpci_caps_scan_chain(fake_read, &cfg, &caps), 0);
+    CHECK(!vpci_caps_usable(&caps));
+}
+
+static void test_scan_falls_back_when_0x34_is_unreadable(void)
+{
+    fake_cfg_t cfg;
+    vpci_caps_t caps;
+
+    build_device(&cfg);
+    cfg.deny_below_0x40 = true;
+    CHECK_EQ(vpci_caps_scan_chain(fake_read, &cfg, &caps), -1);
+    CHECK_EQ(vpci_caps_scan(fake_read, &cfg, &caps), 0);
+    CHECK(vpci_caps_usable(&caps));
+    CHECK_EQ(caps.notify.offset, 0x2000);
+    CHECK_EQ(caps.notify.notify_off_multiplier, 4);
+}
+
+static void test_linear_scan_skips_capability_interiors(void)
+{
+    fake_cfg_t cfg;
+    vpci_caps_t caps;
+
+    build_device(&cfg);
+    /* A dword inside the 20-byte NOTIFY capability (its multiplier field)
+     * that looks like the start of an ISR capability at BAR 0, offset 0.
+     * Only the skip keeps it from overwriting the real ISR capability. */
+    cfg.bytes[0x60] = VPCI_CAP_ID_VENDOR;
+    cfg.bytes[0x61] = 0x00u;
+    cfg.bytes[0x62] = 16u;
+    cfg.bytes[0x63] = VPCI_CFG_ISR;
+    CHECK_EQ(vpci_caps_scan_linear(fake_read, &cfg, &caps), 0);
+    CHECK_EQ(caps.isr.offset, 0x3000);
+    CHECK_EQ(caps.common.offset, 0x1000);
+}
+
+static void test_notify_address_uses_the_multiplier(void)
+{
+    fake_cfg_t cfg;
+    vpci_caps_t caps;
+
+    build_device(&cfg);
+    CHECK_EQ(vpci_caps_scan_chain(fake_read, &cfg, &caps), 0);
+    CHECK_EQ(vpci_caps_notify_addr(&caps, 0), 0x2000);
+    CHECK_EQ(vpci_caps_notify_addr(&caps, 3), 0x200Cu);
+}
+
+static void test_queue_size_is_clamped_to_a_power_of_two(void)
+{
+    CHECK_EQ(vpci_queue_size_clamp(1024, 128), 128);
+    CHECK_EQ(vpci_queue_size_clamp(1024, 100), 64);
+    CHECK_EQ(vpci_queue_size_clamp(8, 8), 8);
+    CHECK_EQ(vpci_queue_size_clamp(1, 16), 2);
+    CHECK_EQ(vpci_queue_size_clamp(0, 16), 2);
+}
+
+int main(void)
+{
+    test_chain_finds_every_capability();
+    test_chain_rejects_a_cycle();
+    test_missing_notify_is_not_usable();
+    test_scan_falls_back_when_0x34_is_unreadable();
+    test_linear_scan_skips_capability_interiors();
+    test_notify_address_uses_the_multiplier();
+    test_queue_size_is_clamped_to_a_power_of_two();
+    return TEST_RESULT();
+}
