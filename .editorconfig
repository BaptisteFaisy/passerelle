# SPDX-License-Identifier: Apache-2.0
#
# .editorconfig - keep the editor defaults aligned with the CI gates.
# https://editorconfig.org
#
# The values below are the ones enforced by tools/quality/check_format.py
# (spaces, no tab, no trailing whitespace, final newline, 100 columns) so an
# editor that honours this file cannot produce a violation.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{c,h}]
# clang-format wraps at 90 columns; 100 is the hard limit checked in CI.
max_line_length = 100

[*.py]
max_line_length = 100

# GitHub Actions, Mergify and the YAML presets are two-space indented.
[*.{yml,yaml}]
indent_size = 2

[*.json]
indent_size = 4

[*.md]
# Two trailing spaces are a hard line break in Markdown.
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
